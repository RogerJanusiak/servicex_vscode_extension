{
  "name": "servicex-vscode-extension",
  "displayName": "ServiceX Helper",
  "description": "Manage ServiceX transform caches and jobs from VS Code",
  "version": "0.5.0",
  "publisher": "RogerJanusiak",
  "license": "BSD-3-Clause",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RogerJanusiak/servicex_vscode_extension.git"
  },
  "bugs": {
    "url": "https://github.com/RogerJanusiak/servicex_vscode_extension/issues"
  },
  "homepage": "https://github.com/RogerJanusiak/servicex_vscode_extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "servicex.refreshCache",
        "title": "ServiceX: Refresh Cached Transforms",
        "icon": "$(refresh)"
      },
      {
        "command": "servicex.deleteFromCache",
        "title": "ServiceX: Delete from Cache",
        "icon": "$(trash)"
      },
      {
        "command": "servicex.cleanGroup",
        "title": "ServiceX: Clean Old Requests",
        "icon": "$(clear-all)"
      },
      {
        "command": "servicex.deleteGroup",
        "title": "ServiceX: Delete Entire Group",
        "icon": "$(trash)"
      },
      {
        "command": "servicex.copyRequestId",
        "title": "ServiceX: Copy Request ID",
        "icon": "$(copy)"
      },
      {
        "command": "servicex.copyFileList",
        "title": "ServiceX: Copy File List",
        "icon": "$(files)"
      },
      {
        "command": "servicex.showQuery",
        "title": "ServiceX: Show Query",
        "icon": "$(code)"
      },
      {
        "command": "servicex.openDashboard",
        "title": "ServiceX: Open in Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "servicex.openCacheFolder",
        "title": "ServiceX: Open Cache Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "servicex.openCacheRootFolder",
        "title": "ServiceX: Open Root Cache Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "servicex.openFilterMenu",
        "title": "ServiceX: Filter...",
        "icon": "$(filter)"
      },
      {
        "command": "servicex.clearAllFilters",
        "title": "ServiceX: Clear All Filters"
      },
      {
        "command": "servicex.openSortMenu",
        "title": "ServiceX: Sort...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "servicex.groupByTitle",
        "title": "ServiceX: Group by Title",
        "icon": "$(list-tree)"
      },
      {
        "command": "servicex.ungroup",
        "title": "ServiceX: Ungroup",
        "icon": "$(list-flat)"
      },
      {
        "command": "servicex.refreshDashboard",
        "title": "ServiceX: Refresh Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "servicex.openDashboardFilterMenu",
        "title": "ServiceX: Filter Dashboard...",
        "icon": "$(filter)"
      },
      {
        "command": "servicex.clearAllDashboardFilters",
        "title": "ServiceX: Clear All Dashboard Filters"
      },
      {
        "command": "servicex.openDashboardSortMenu",
        "title": "ServiceX: Sort Dashboard...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "servicex.groupDashboardByTitle",
        "title": "ServiceX: Group Dashboard by Title",
        "icon": "$(list-tree)"
      },
      {
        "command": "servicex.ungroupDashboard",
        "title": "ServiceX: Ungroup Dashboard",
        "icon": "$(list-flat)"
      },
      {
        "command": "servicex.cancelTransform",
        "title": "ServiceX: Cancel Transform",
        "icon": "$(stop-circle)"
      },
      {
        "command": "servicex.deleteAllCache",
        "title": "ServiceX: Delete All Cached Transforms",
        "icon": "$(trash)"
      },
      {
        "command": "servicex.cleanAllGroups",
        "title": "ServiceX: Clean All Groups",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "servicex",
          "title": "ServiceX Helper",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "servicex": [
        {
          "id": "servicexCacheView",
          "name": "Cached Transforms"
        },
        {
          "id": "servicexDashboardView",
          "name": "Dashboard Transforms"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "servicex.openFilterMenu",
          "when": "view == servicexCacheView",
          "group": "navigation@1"
        },
        {
          "command": "servicex.openSortMenu",
          "when": "view == servicexCacheView",
          "group": "navigation@2"
        },
        {
          "command": "servicex.groupByTitle",
          "when": "view == servicexCacheView && !servicex.groupingEnabled",
          "group": "navigation@3"
        },
        {
          "command": "servicex.ungroup",
          "when": "view == servicexCacheView && servicex.groupingEnabled",
          "group": "navigation@3"
        },
        {
          "command": "servicex.refreshCache",
          "when": "view == servicexCacheView",
          "group": "navigation@4"
        },
        {
          "command": "servicex.clearAllFilters",
          "when": "view == servicexCacheView",
          "group": "1_filter"
        },
        {
          "command": "servicex.openCacheRootFolder",
          "when": "view == servicexCacheView",
          "group": "2_folder"
        },
        {
          "command": "servicex.cleanAllGroups",
          "when": "view == servicexCacheView",
          "group": "3_danger@1"
        },
        {
          "command": "servicex.deleteAllCache",
          "when": "view == servicexCacheView",
          "group": "3_danger@2"
        },
        {
          "command": "servicex.openDashboardFilterMenu",
          "when": "view == servicexDashboardView",
          "group": "navigation@1"
        },
        {
          "command": "servicex.openDashboardSortMenu",
          "when": "view == servicexDashboardView",
          "group": "navigation@2"
        },
        {
          "command": "servicex.groupDashboardByTitle",
          "when": "view == servicexDashboardView && !servicex.dashboardGroupingEnabled",
          "group": "navigation@3"
        },
        {
          "command": "servicex.ungroupDashboard",
          "when": "view == servicexDashboardView && servicex.dashboardGroupingEnabled",
          "group": "navigation@3"
        },
        {
          "command": "servicex.refreshDashboard",
          "when": "view == servicexDashboardView",
          "group": "navigation@4"
        },
        {
          "command": "servicex.clearAllDashboardFilters",
          "when": "view == servicexDashboardView",
          "group": "1_filter"
        }
      ],
      "view/item/context": [
        {
          "command": "servicex.deleteFromCache",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "inline"
        },
        {
          "command": "servicex.copyRequestId",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "1_copy@1"
        },
        {
          "command": "servicex.copyFileList",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "1_copy@2"
        },
        {
          "command": "servicex.showQuery",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "2_open@1"
        },
        {
          "command": "servicex.openDashboard",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "2_open@2"
        },
        {
          "command": "servicex.openCacheFolder",
          "when": "view == servicexCacheView && viewItem == servicexCacheRequest",
          "group": "2_open@3"
        },
        {
          "command": "servicex.cleanGroup",
          "when": "view == servicexCacheView && viewItem == servicexTitleGroup",
          "group": "inline"
        },
        {
          "command": "servicex.deleteGroup",
          "when": "view == servicexCacheView && viewItem == servicexTitleGroup",
          "group": "inline"
        },
        {
          "command": "servicex.copyRequestId",
          "when": "view == servicexDashboardView && viewItem =~ /^servicexDashboardRequest/",
          "group": "1_copy@1"
        },
        {
          "command": "servicex.showQuery",
          "when": "view == servicexDashboardView && viewItem =~ /^servicexDashboardRequest/",
          "group": "2_open@1"
        },
        {
          "command": "servicex.openDashboard",
          "when": "view == servicexDashboardView && viewItem =~ /^servicexDashboardRequest/",
          "group": "2_open@2"
        },
        {
          "command": "servicex.cancelTransform",
          "when": "view == servicexDashboardView && viewItem == servicexDashboardRequest-running",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ServiceX Helper",
      "properties": {
        "servicex.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to a specific servicex.yaml/.servicex file. If empty, searches the workspace folder (and its parents) then the home directory, same as the servicex CLI."
        },
        "servicex.backend": {
          "type": "string",
          "default": "",
          "description": "Name of the backend endpoint to use from the config file. If empty, uses the config file's default-endpoint (or the first endpoint listed)."
        },
        "servicex.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to decode func_adl queries for \"Show Query\" (it needs the `qastle` package, which servicex installs). If empty, uses the interpreter selected by the Python extension, then python3/python from PATH."
        },
        "servicex.showQueryMetadata": {
          "type": "boolean",
          "default": false,
          "description": "Keep the generated MetaData(...) wrappers in the query shown by \"Show Query\". func_adl's backend packages add one per C++ type and method the query touches - often dozens - so they are removed by default."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "ovsx": "^1.0.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
